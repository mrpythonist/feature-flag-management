// Feature Flag & Release Management Platform — data model.
//
// Project 1—N Environment (development | staging | production), each with its
// own SDK key used by applications to fetch flag values.
// Project 1—N Flag; each Flag has exactly one FlagConfig per Environment,
// holding the effective value (enabled, percentage rollout, targeted users).
// Every config change is recorded in AuditLog with before/after snapshots.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  createdAt   DateTime      @default(now())
  environments Environment[]
  flags       Flag[]
  auditLogs   AuditLog[]
}

model Environment {
  id          String       @id @default(cuid())
  projectId   String
  name        String       // development | staging | production
  sdkKey      String       @unique // 48-char hex, used by the SDK evaluate API
  createdAt   DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flagConfigs FlagConfig[]
  auditLogs   AuditLog[]

  @@unique([projectId, name])
  @@index([sdkKey])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Flag {
  id          String       @id @default(cuid())
  projectId   String
  key         String       // slug-like key used by SDKs, e.g. "new_checkout"
  name        String
  description String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configs     FlagConfig[]
  auditLogs   AuditLog[]

  @@unique([projectId, key])
}

model FlagConfig {
  id                String      @id @default(cuid())
  flagId            String
  environmentId     String
  enabled           Boolean     @default(false)
  rolloutPercentage Int         @default(0) // 0–100
  targetedUsers     String[]    // user IDs the flag is force-enabled for
  updatedAt         DateTime    @updatedAt
  flag              Flag        @relation(fields: [flagId], references: [id], onDelete: Cascade)
  environment       Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([flagId, environmentId])
}

model AuditLog {
  id            String       @id @default(cuid())
  projectId     String
  flagId        String?
  environmentId String?
  actor         String       // admin email, or "seed"
  action        String       // flag.created | flag.updated | flag.deleted | config.updated
  before        Json?
  after         Json?
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flag          Flag?        @relation(fields: [flagId], references: [id], onDelete: SetNull)
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}
