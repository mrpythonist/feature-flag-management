# API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/featureflags?schema=public"
# Optional: if unset (or unreachable), the API runs without Redis caching.
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
PORT=3001

# Web (dashboard). Must be reachable from the browser.
NEXT_PUBLIC_API_URL="http://localhost:3001"
